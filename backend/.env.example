# ================================================================
# ZIPREE — Backend environment variables (example / template)
# ================================================================
# This file is a TEMPLATE. Do NOT put real secrets here.
# Copy it to ".env" and fill in real values:
#
#   cp .env.example .env
#
# Then edit ".env". The ".env" file is gitignored — never commit it.
# ================================================================


# ---- Server ----
# Port the Express server listens on.
PORT=5000

# "development" or "production".
# - development: stack traces in error responses, verbose logging.
# - production:  stack traces hidden.
NODE_ENV=development


# ---- Frontend / CORS ----
# The exact origin of your frontend. CORS will only allow this origin.
# - Vite  (default): http://localhost:5173
# - CRA   (default): http://localhost:3000
# - Next.js (default): http://localhost:3000
CLIENT_URL=http://localhost:5173


# ---- Database (required from Phase 2) ----
# MongoDB connection string.
#
# Standard Atlas (shared cluster):
#   mongodb+srv://<user>:<password>@<cluster-host>/zipree?retryWrites=true&w=majority
#
# Sharded Atlas (3 shard hosts, as commonly shown in Atlas UI):
#   mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/zipree?ssl=true&replicaSet=<rsName>&authSource=admin&retryWrites=true&w=majority
#
# Notes:
# - Database name must be "zipree" (not "test" or any other name).
# - If your password contains special characters (@ : / ? # & %),
#   URL-encode them, e.g. "@" -> "%40", "#" -> "%23".
# - The database is created automatically on the first write.
MONGO_URI=


# ---- Auth / JWT (required from Phase 3) ----
# Secret used to sign JSON Web Tokens. MUST be long and random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Copy the output here and into your real ".env". Never reuse across projects.
JWT_SECRET=

# How long a login token stays valid. Examples: "1h", "12h", "7d", "30d".
JWT_EXPIRES_IN=7d



# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mossie.parisian3@ethereal.email
